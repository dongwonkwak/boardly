    // Given
    SearchUsersQuery query = new SearchUsersQuery("john", filters);
    List<UserId> userIds = Arrays.asList(UserId.from("user-1"), UserId.from("user-2"));
    List<User> users = Arrays.asList(user1, user2);
    
    when(searchEngine.searchUsers(query.getKeyword(), query.getFilters())).thenReturn(Optional.of(userIds));
    when(userRepository.findAllById(userIds)).thenReturn(users);
    
    // When
    Either<Failure, List<User>> result = userSearchService.searchUsers(query);
    
    // Then
    assertThat(result.isRight()).isTrue();
    assertThat(result.get()).hasSize(2);
}

