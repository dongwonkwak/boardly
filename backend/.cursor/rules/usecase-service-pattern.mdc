│   │   ├── DeleteUserCommand.java     // Command 객체
│   │   └── validation/                // Command 검증 관련 (상세 구조는 command-validation-pattern.mdc 참조)
│   └── out/
│       ├── PasswordHasher.java        // Outbound Interface (boardly-infrastructure에서 구현)
│       └── UserEmailService.java      // Outbound Interface (boardly-infrastructure에서 구현)
├── UserCrudService.java               // UseCase 구현체 - Service로 이름 끝남
├── UserAnalyticsService.java          // UseCase 구현체
