// ✅ 테스트 데이터 빌더
public class TestDataBuilder {
    
    public static User.UserBuilder aUser() {
        return User.builder()
            .name("Test User")
            .email("test@example.com");
    }
    
    public static Board.BoardBuilder aBoard() {
        return Board.builder()
            .title("Test Board")
            .description("Test Description");
    }
    
    public static CreateUserCommand.CreateUserCommandBuilder aCreateUserCommand() {
        return CreateUserCommand.builder()
            .name("Test User")
            .email("test@example.com")
            .password("password123");
    }
}

// ✅ 테스트에서 사용
@Test
void shouldCreateUserSuccessfully() {
    // Given
    CreateUserCommand command = TestDataBuilder.aCreateUserCommand().build();
    
    // When
    Either<Failure, User> result = createUserUseCase.createUser(command);
    
    // Then
    assertThat(result.isRight()).isTrue();
}
