## MessageKey와 국제화 지원
```java
// ✅ 메시지 키 사용 예시
public class MessageKeyUsage {
    
    // 1. 명확한 메시지 키 네이밍
    public Either<Failure, User> validateUser(User user) {
        if (user.getEmail() == null) {
            return Either.left(Failure.ofInputError("user.email.required"));
        }
        
        if (!isValidEmailFormat(user.getEmail())) {
            return Either.left(Failure.ofInputError("user.email.invalid.format"));
        }
        
        return Either.right(user);
    }
    
    // 2. Context 정보와 함께 사용
    public Either<Failure, Board> findBoardWithPermission(BoardId boardId, UserId userId) {
        return boardRepository.findById(boardId)
            .map(board -> {
                if (!board.hasReadPermission(userId)) {
                    return Either.<Failure, Board>left(
                        Failure.ofPermissionDenied("board.read.permission.denied", 
                            Map.of("boardId", boardId, "userId", userId))
                    );
                }
                return Either.<Failure, Board>right(board);
            })
            .orElse(Either.left(Failure.ofNotFound("board.not.found", boardId)));
    }
    
    // 3. 필드별 상세 검증
    public Either<Failure, User> validateUserRegistration(CreateUserCommand command) {
        List<Failure.FieldViolation> violations = new ArrayList<>();
        
        // 이메일 검증
        if (command.email() == null || command.email().trim().isEmpty()) {
            violations.add(Failure.FieldViolation.builder()
                .field("email")
                .messageKey("user.email.required")
                .rejectedValue(command.email())
                .build());
        } else if (!EmailValidator.isValid(command.email())) {
            violations.add(Failure.FieldViolation.builder()
                .field("email")
                .messageKey("user.email.invalid.format")
                .rejectedValue(command.email())
                .build());
        }
        
        // 이름 검증
        if (command.name() == null || command.name().trim().isEmpty()) {
            violations.add(Failure.FieldViolation.builder()
                .field("name")
                .messageKey("user.name.required")
                .rejectedValue(command.name())
                .build());
        } else if (command.name().length() > 50) {
            violations.add(Failure.FieldViolation.builder()
                .field("name")
                .messageKey("user.name.too.long")
                .rejectedValue(command.name())
                .build());
        }
        
        if (!violations.isEmpty()) {
            return Either.left(Failure.ofInputError("user.validation.failed", violations));
        }
        
        return Either.right(User.create(command));
    }
}
```

