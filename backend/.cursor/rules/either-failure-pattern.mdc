## 실제 프로젝트 적용 예시
```java
// ✅ 회원가입 UseCase에서의 활용
@Service
@RequiredArgsConstructor
public class SignUpUseCaseImpl implements SignUpUseCase {
    
    private final UserRepository userRepository;
    private final UserValidators userValidators;
    
    @Override
    public Either<Failure, User> signUp(SignUpCommand command) {
        // 1. 입력값 검증
        Either<Failure, SignUpCommand> validationResult = userValidators.validateSignUpCommand(command);
        if (validationResult.isLeft()) {
            return Either.left(validationResult.getLeft());
        }
        
        // 2. 이메일 중복 검사
        if (userRepository.existsByEmail(command.email())) {
            return Either.left(Failure.ofConflict("user.email.already.exists"));
        }
        
        // 3. 사용자 생성 및 저장
        User user = User.create(command);
        return userRepository.save(user);
    }
}

// ✅ 패스워드 변경 UseCase에서의 활용  
@Service
@RequiredArgsConstructor
public class ChangePasswordUseCaseImpl implements ChangePasswordUseCase {
    
    private final UserRepository userRepository;
    private final PasswordEncoder passwordEncoder;
    
    @Override
    public Either<Failure, User> changePassword(ChangePasswordCommand command) {
        // 1. 사용자 조회
        Optional<User> userOpt = userRepository.findById(command.userId());
        if (userOpt.isEmpty()) {
            return Either.left(Failure.ofNotFound("user.not.found"));
        }
        
        User user = userOpt.get();
        
        // 2. 현재 패스워드 검증
        if (!passwordEncoder.matches(command.currentPassword(), user.getPassword())) {
            return Either.left(Failure.ofInputError("user.password.current.invalid"));
        }
        
        // 3. 새 패스워드 정책 검증
        if (!isValidPassword(command.newPassword())) {
            return Either.left(Failure.ofBusinessRuleViolation("user.password.policy.violation"));
        }
        
        // 4. 패스워드 변경
        User updatedUser = user.changePassword(command.newPassword(), passwordEncoder);
        return userRepository.save(updatedUser);
    }
}
