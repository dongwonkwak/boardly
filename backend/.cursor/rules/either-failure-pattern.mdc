// 기존 예외 기반 코드를 Either로 마이그레이션
public class MigrationGuide {
    
    // ❌ 기존 방식 (예외 기반)
    public User createUserOld(CreateUserCommand command) {
        if (command.email() == null) {
            throw new IllegalArgumentException("Email is required");
        }
        
        if (userRepository.existsByEmail(command.email())) {
            throw new DuplicateEmailException("Email already exists");
        }
        
        User user = new User(command.name(), command.email());
        return userRepository.save(user);
    }
    
    // ✅ 새로운 방식 (Either 기반)
    public Either<Failure, User> createUserNew(CreateUserCommand command) {
        if (command.email() == null) {
            return Either.left(Failure.ofInputError("user.email.required"));
        }
        
        if (userRepository.existsByEmail(command.email())) {
            return Either.left(Failure.ofConflict("user.email.already.exists"));
        }
        
        User user = new User(command.name(), command.email());
        return userRepository.save(user);
    }
}
