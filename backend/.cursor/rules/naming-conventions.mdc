## Vavr Validation 사용 규칙
```java
// ✅ Command별 Validator 생성
@Component
@RequiredArgsConstructor
public class CreateUserCommandValidator {
    
    private final CommonFieldValidator commonValidator;
    
    public Validation<Seq<String>, CreateUserCommand> validate(CreateUserCommand command) {
        return Validation.combine(
            commonValidator.validateNotBlank(command.name(), "name"),
            commonValidator.validateEmail(command.email(), "email"),
            commonValidator.validatePassword(command.password(), "password")
        ).ap(CreateUserCommand::new);
    }
}

// ✅ 공통 검증 로직
@Component
public class CommonFieldValidator {
    
    public Validation<String, String> validateNotBlank(String value, String fieldName) {
        return StringUtils.hasText(value) 
            ? Validation.valid(value)
            : Validation.invalid(fieldName + " cannot be blank");
    }
    
    public Validation<String, String> validateEmail(String email, String fieldName) {
        return EmailValidator.getInstance().isValid(email)
            ? Validation.valid(email)
            : Validation.invalid(fieldName + " must be a valid email");
    }
    
    public Validation<String, String> validatePassword(String password, String fieldName) {
        if (password == null || password.length() < 8) {
            return Validation.invalid(fieldName + " must be at least 8 characters");
        }
        return Validation.valid(password);
    }
}
```

