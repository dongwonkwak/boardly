## Either 체이닝 패턴
```java
// ✅ Either 체이닝을 통한 복잡한 로직 처리
@Override
public Either<Failure, Board> createBoardWithMembers(CreateBoardCommand command) {
    return validateBoardCommand(command)
        .flatMap(this::createBoard)
        .flatMap(board -> addMembersToBoard(board, command.memberIds()))
        .flatMap(this::saveBoard);
}

private Either<Failure, CreateBoardCommand> validateBoardCommand(CreateBoardCommand command) {
    Validation<Seq<String>, CreateBoardCommand> validation = validator.validate(command);
    if (validation.isInvalid()) {
        return Either.left(Failure.InputError(validation.getError().asJava()));
    }
    return Either.right(command);
}

private Either<Failure, Board> createBoard(CreateBoardCommand command) {
    Board board = Board.create(command.title(), command.description(), command.ownerId());
    return Either.right(board);
}

private Either<Failure, Board> addMembersToBoard(Board board, List<UserId> memberIds) {
    for (UserId memberId : memberIds) {
        Either<Failure, Board> result = board.addMember(memberId);
        if (result.isLeft()) {
            return result;
        }
        board = result.get();
    }
    return Either.right(board);
}

private Either<Failure, Board> saveBoard(Board board) {
    return boardRepository.save(board);
}
```

## 성능 고려사항
```java
// ✅ Either 사용 시 성능 최적화
public class EitherPerformanceOptimization {
    
    // 1. 불필요한 Either 생성 방지
    public Either<Failure, User> findUserOptimized(UserId userId) {
        Optional<User> userOpt = userRepository.findById(userId);
        return userOpt.map(Either::<Failure, User>right)
                     .orElse(Either.left(Failure.ofNotFound("user.not.found")));
    }
    
    // 2. 대량 처리 시 Either 사용 최소화
    public List<User> findAllUsersOptimized() {
        // 단순 조회는 Either 없이 처리
        return userRepository.findAll();
    }
    
    // 3. 캐싱과 함께 사용
    public Either<Failure, User> findUserWithCache(UserId userId) {
        return userCache.get(userId)
            .map(Either::<Failure, User>right)
            .orElseGet(() -> findUserFromRepository(userId));
    }
}
