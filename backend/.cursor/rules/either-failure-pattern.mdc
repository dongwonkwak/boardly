## Deprecated 메서드 마이그레이션
```java
// ❌ 기존 메서드 (Deprecated)
// Failure.ofValidationFailure() -> Failure.ofInputError()
// Failure.ofConflictFailure() -> Failure.ofConflict()  
// Failure.ofNotFoundFailure() -> Failure.ofNotFound()
// Failure.ofForbiddenFailure() -> Failure.ofPermissionDenied()

// ✅ 새로운 메서드 사용
public Either<Failure, User> migratedExample(CreateUserCommand command) {
    // 기존: Failure.ofValidationFailure("message", violations)
    // 신규: Failure.ofInputError("messageKey", violations)
    if (hasValidationErrors(command)) {
        return Either.left(Failure.ofInputError("user.validation.failed", violations));
    }
    
    // 기존: Failure.ofConflictFailure("message")  
    // 신규: Failure.ofConflict("messageKey")
    if (userRepository.existsByEmail(command.email())) {
        return Either.left(Failure.ofConflict("user.email.already.exists"));
    }
    
    return Either.right(createUser(command));
}
