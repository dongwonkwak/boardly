## 테스트에서 Either 검증
```java
@Test
@DisplayName("사용자 생성 성공")
void shouldCreateUserSuccessfully() {
    // Given
    CreateUserCommand command = CreateUserCommand.of("John Doe", "john@example.com");
    
    // When
    Either<Failure, User> result = createUserUseCase.createUser(command);
    
    // Then
    assertThat(result.isRight()).isTrue();
    assertThat(result.get()).isNotNull();
    assertThat(result.get().getName()).isEqualTo("John Doe");
}

@Test
@DisplayName("이메일 중복으로 인한 사용자 생성 실패")
void shouldFailToCreateUserWithDuplicateEmail() {
    // Given
    CreateUserCommand command = CreateUserCommand.of("John Doe", "existing@example.com");
    
    // When
    Either<Failure, User> result = createUserUseCase.createUser(command);
    
    // Then
    assertThat(result.isLeft()).isTrue();
    assertThat(result.getLeft()).isInstanceOf(Failure.ResourceConflict.class);
    assertThat(result.getLeft().getHttpStatus()).isEqualTo(HttpStatus.CONFLICT);
}

@Test
@DisplayName("입력값 검증 실패")
void shouldFailToCreateUserWithInvalidInput() {
    // Given
    CreateUserCommand command = CreateUserCommand.of("", "invalid-email");
    
    // When
    Either<Failure, User> result = createUserUseCase.createUser(command);
    
    // Then
    assertThat(result.isLeft()).isTrue();
    assertThat(result.getLeft()).isInstanceOf(Failure.InputError.class);
    assertThat(result.getLeft().getHttpStatus()).isEqualTo(HttpStatus.BAD_REQUEST);
}
