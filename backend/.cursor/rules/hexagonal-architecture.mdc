// ✅ 아키텍처 규칙 검증
@Test
void hexagonalArchitectureShouldBeRespected() {
    ArchRule rule = layeredArchitecture()
        .consideringOnlyDependenciesInLayers()
        .layer("Shared").definedBy("..shared..")
        .layer("Domain").definedBy("..domain..")
        .layer("Application").definedBy("..application..")
        .layer("Infrastructure").definedBy("..infrastructure..")
        .layer("API").definedBy("..api..")
        .whereLayer("Shared").mayOnlyBeAccessedByLayers("Domain", "Application", "Infrastructure", "API")
        .whereLayer("Domain").mayOnlyBeAccessedByLayers("Application", "Infrastructure")
        .whereLayer("Application").mayOnlyBeAccessedByLayers("Infrastructure", "API")
        .whereLayer("Infrastructure").mayNotBeAccessedByAnyLayer()
        .whereLayer("API").mayNotBeAccessedByAnyLayer();

    rule.check(importedClasses);
}
