// ✅ Validator
@Component
@RequiredArgsConstructor
public class CreateUserCommandValidator {
    
    private final CommonFieldValidator commonValidator;
    
    public Validation<Seq<String>, CreateUserCommand> validate(CreateUserCommand command) {
        return Validation.combine(
            commonValidator.validateNotBlank(command.name(), "name"),
            commonValidator.validateEmail(command.email(), "email"),
            commonValidator.validatePassword(command.password(), "password")
        ).ap(CreateUserCommand::new);
    }
}
